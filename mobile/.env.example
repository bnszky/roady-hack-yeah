# Copy this file to `.env.local` and fill in real values.
# Docs: https://docs.expo.dev/guides/environment-variables/

# Base URL of the FastAPI backend. `localhost` is rewritten by `src/lib/env.ts`:
# Android emulator -> 10.0.2.2, physical phone -> your computer's LAN IP (the Metro host).
# On a phone run the backend with `--host 0.0.0.0`. Any other host is used as is.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase (Project Settings -> API). Optional: without it the app runs without sign-in.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Mapbox public access token (pk.*) -> https://console.mapbox.com/account/access-tokens/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=<mapbox-public-token>
