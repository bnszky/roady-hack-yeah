# Copy this file to `.env.local` and fill in real values.
# Docs: https://docs.expo.dev/guides/environment-variables/

# Base URL of the FastAPI backend. On the Android emulator, `localhost` is
# automatically rewritten to `10.0.2.2` by `src/lib/env.ts`.
# For a physical device use your computer's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
