# App
DEBUG=false
LOG_LEVEL=INFO

# Set to false to disable JWT auth validation while prototyping (level TBD)
AUTH_REQUIRED=true

# Supabase (Project Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Database — direct Postgres connection.
# Local (Supabase CLI): postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
# Production (Supabase -> Connect -> Transaction pooler):
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# CORS origins (JSON array) — only relevant for web clients
CORS_ORIGINS=["*"]
