# App
DEBUG=false
LOG_LEVEL=INFO

# Set to false to disable JWT auth validation while prototyping (level TBD)
AUTH_REQUIRED=true

# Supabase (Project Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Database — direct Postgres connection.
# Local (Supabase CLI): postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
# Production (Supabase -> Connect -> Transaction pooler):
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# CORS origins (JSON array) — only relevant for web clients
CORS_ORIGINS=["*"]

# Groq (voice assistant LLM, /process-command) -> https://console.groq.com/keys
GROQ_API_KEY=<groq-api-key>

# Problems
PROBLEM_DEDUPE_RADIUS_M=30
PROBLEM_DENIAL_THRESHOLD=3
NEARBY_DEFAULT_RADIUS_M=50
ROUTE_DEFAULT_BUFFER_M=30

# Routing (OSRM-compatible, walking)
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
OSRM_PROFILE=foot

# Voice assistant (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
